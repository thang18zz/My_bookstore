# HƯỚNG DẪN CẤU HÌNH LOCAL:
# Sao chép (copy) file này thành 'application-local.yml' trong cùng thư mục
# Điền thông tin mật khẩu MySQL và API Key của bạn vào bên dưới.
# File 'application-local.yml' đã được chặn trong .gitignore nên không sợ bị lộ lên GitHub.

spring:
  datasource:
    password: "YOUR_MYSQL_PASSWORD_HERE"

groq:
  api-key: "YOUR_GROQ_API_KEY_HERE"

monapay:
  base-url: https://api.monapay.vn
  client-id: "YOUR_CLIENT_ID"       # Điền trực tiếp trong dấu ngoặc kép, KHÔNG dùng ${...}
  client-secret: "YOUR_CLIENT_SECRET" # Điền trực tiếp trong dấu ngoặc kép, KHÔNG dùng ${...}
  webhook-secret: "YOUR_WEBHOOK_SECRET" # Điền trực tiếp trong dấu ngoặc kép, KHÔNG dùng ${...}
  sandbox: true
  expires-in: 900
  return-url: http://localhost:5173/orders
  cancel-url: http://localhost:5173/cart
